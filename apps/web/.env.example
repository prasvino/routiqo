# Same-origin path to Routiqo's reviewed MapLibre style JSON and self-hosted map resources.
# Set this in apps/web/.env.local, for example /maps/styles/routiqo.json.
NEXT_PUBLIC_MAP_STYLE_PATH=
NEXT_PUBLIC_ROUTIQO_PUBLIC_SIGNAL_INTENT_UI_ENABLED=false
NEXT_PUBLIC_ROUTIQO_PUBLIC_SIGNAL_INTENT_SHARE_ENABLED=false
NEXT_PUBLIC_ROUTIQO_COMMUNITY_TRAFFIC_V3_ENABLED=false
ROUTIQO_COMMUNITY_TRAFFIC_V3_ENABLED=false
# ADR 0062 account planning copy: the server flag gates the same-origin proxy, the public flag shows Profile controls.
ROUTIQO_PLANNING_BACKUP_API_ENABLED=false
NEXT_PUBLIC_ROUTIQO_PLANNING_BACKUP_UI_ENABLED=false
