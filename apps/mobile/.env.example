# Public identifiers only. A missing value keeps native account/map controls unavailable.
# The origin must be an HTTPS host with no path, query, fragment or custom port.
EXPO_PUBLIC_ROUTIQO_API_ORIGIN=
# Web OAuth client ID whose audience is configured in core-api google-auth.
EXPO_PUBLIC_ROUTIQO_GOOGLE_WEB_CLIENT_ID=
# Reviewed style and all referenced resources must be served by the API origin.
EXPO_PUBLIC_ROUTIQO_MAP_STYLE_PATH=
# Private LIVE contribution controls remain unavailable until the paired API is enabled.
EXPO_PUBLIC_ROUTIQO_NATIVE_LIVE_CONSENT_ENABLED=false
# Explicit place search and route estimates require the paired native routing API.
EXPO_PUBLIC_ROUTIQO_NATIVE_ROUTING_ENABLED=false
# Full-screen Journey mode with the route, your own position (on device only) and Spots ahead.
# Starting with a route needs native routing too. Exact `true` only.
EXPO_PUBLIC_ROUTIQO_JOURNEY_MAP_ENABLED=false
# Spots-ahead panel, catalog cache and activity refresh in Journey mode (needs the Journey map flag). Exact `true` only.
EXPO_PUBLIC_ROUTIQO_SPOTS_ENABLED=false
# Posting, one-tap signals, votes, Report, Block, the offline Spot queue and Ghost Mode (needs the Spots flag and the server's contribution flag). Exact `true` only.
EXPO_PUBLIC_ROUTIQO_SPOT_CONTRIBUTIONS_ENABLED=false
# Private route context preparation requires the paired native binding API.
EXPO_PUBLIC_ROUTIQO_NATIVE_LIVE_ROUTE_BINDING_ENABLED=false
