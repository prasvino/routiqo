{
  "expo": {
    "name": "Routiqo",
    "slug": "routiqo",
    "version": "0.1.0",
    "scheme": "routiqo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.routiqo.app"
    },
    "android": {
      "package": "com.routiqo.app"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
