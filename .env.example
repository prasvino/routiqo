# Client-visible API base (public catalog only in foundation)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# No production secrets belong here.

# Backend process settings only; this file is not automatically loaded by Spring.
# Required together when web-auth and routing profiles are enabled.
# Use operator-reviewed Routiqo-controlled origins and conservative dataset bounds.
# No public service defaults or guessed bounds are supplied.
ROUTIQO_VALHALLA_ORIGIN=
ROUTIQO_PHOTON_ORIGIN=
ROUTIQO_ROUTING_REGION_WEST=
ROUTIQO_ROUTING_REGION_SOUTH=
ROUTIQO_ROUTING_REGION_EAST=
ROUTIQO_ROUTING_REGION_NORTH=
