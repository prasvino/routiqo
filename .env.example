# Client-visible API base (public catalog only in foundation)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# No production secrets belong here.

# Backend process settings only; this file is not automatically loaded by Spring.
# Required together when web-auth and routing profiles are enabled.
# Use operator-reviewed Routiqo-controlled origins and conservative dataset bounds.
# No public service defaults or guessed bounds are supplied.
ROUTIQO_VALHALLA_ORIGIN=
ROUTIQO_PHOTON_ORIGIN=
ROUTIQO_ROUTING_REGION_WEST=
ROUTIQO_ROUTING_REGION_SOUTH=
ROUTIQO_ROUTING_REGION_EAST=
ROUTIQO_ROUTING_REGION_NORTH=
ROUTIQO_LIVE_CONSENT_API_ENABLED=false
ROUTIQO_NATIVE_LIVE_CONSENT_API_ENABLED=false
ROUTIQO_NATIVE_ROUTING_API_ENABLED=false
ROUTIQO_LIVE_ROUTE_BINDING_API_ENABLED=false
ROUTIQO_LIVE_SIGNAL_API_ENABLED=false
ROUTIQO_LIVE_CHOICE_API_ENABLED=false
ROUTIQO_LIVE_EXPIRY_MAINTENANCE_ENABLED=false
ROUTIQO_MODERATION_EXPIRY_MAINTENANCE_ENABLED=false
ROUTIQO_LIVE_ANCHOR_RESOLVER_ENABLED=false
ROUTIQO_LIVE_ANCHOR_CATALOG_PATH=
# V3 community traffic summary. These flags stay false in production until a
# separate owner decision and product/privacy/security review are recorded.
ROUTIQO_COMMUNITY_TRAFFIC_V3_ENABLED=false
ROUTIQO_COMMUNITY_TRAFFIC_V3_PUBLISHER_ENABLED=false
ROUTIQO_COMMUNITY_TRAFFIC_V3_MAINTENANCE_ENABLED=false
# Separate V3 moderator staging boundary. No operator grant is seeded by config.
# Keep false in production until independent admin identity, MFA policy, grants,
# report operations and the V3 production decision are reviewed.
ROUTIQO_V3_ADMIN_ENABLED=false
# Separately gated V3 operator grant administration and retention cleanup.
# Neither flag provisions the out-of-band grant administrator trust root.
ROUTIQO_V3_GRANT_ADMIN_ENABLED=false
ROUTIQO_V3_GRANT_ADMIN_MAINTENANCE_ENABLED=false
ROUTIQO_ADMIN_ORIGIN=
ROUTIQO_ADMIN_GOOGLE_CLIENT_ID=
